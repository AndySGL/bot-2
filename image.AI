      "cell_type": "code",
      "source": [
        "# Visualización de la imagen\n",
        "from google.colab.patches import cv2_imshow\n",
        "import cv2\n",
        "\n",
        "img = cv2.imread('output_image.jpg', cv2.IMREAD_UNCHANGED)\n",
        "cv2_imshow(img)"
      ],
      "metadata": {
        "colab": {
          "base_uri": "https://localhost:8080/",
          "height": 489
        },
        "id": "PTucwBkypB6G",
        "outputId": "0a3884ae-8736-4694-c712-21aab85ad807"
      },
      "execution_count": 9,
      "outputs": [
