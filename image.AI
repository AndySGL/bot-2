      "cell_type": "code",
      "source": [
        "# Reconocer imágenes en la imagen seleccionada con una probabilidad de al menos el 30% y guardarlas en un nuevo archivo.\n",
        "detections = detector.detectObjectsFromImage(\n",
        "    input_image=\"/content/input.image.jpg\",\n",
        "    output_image_path=\"output_image.jpg\",\n",
        "    minimum_percentage_probability=30)"
      ],
      "metadata": {
        "id": "3G-aaAN1n39E"
      },
      "execution_count": 6,
      "outputs": []
    },
    {
      "cell_type": "code",
      "source": [
        "for eachObject in detections:\n",
        "    print(eachObject[\"name\"] , \" : \", eachObject[\"percentage_probability\"], \" : \", eachObject[\"box_points\"] )\n",
        "    print(\"--------------------------------\")"
      ],
